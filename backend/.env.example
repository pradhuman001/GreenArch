# Example environment variables for GreenArch backend
# Copy to .env and fill values for local development (do NOT commit secrets to git)

# Server
PORT=3000
ADMIN_EMAIL=admin@greenarch.local
ADMIN_PASSWORD=Admin@12345
TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Payment gateway (Razorpay) - set these only when ready for live/test payments
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# NOTE: Keep these secrets on the server or in your deployment platform's secret manager.
